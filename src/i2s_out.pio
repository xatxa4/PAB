;
; 32 bit stereo I2S output, BCLK = 64fs, no MCLK.
;
; Adapted from the i2s_data program of BambooMaster's pico-i2s-pio (MIT), with
; the two side-set bits swapped so the pin order matches pico-extras' audio_i2s:
;
;   DATA   out pin base
;   BCLK   side-set pin base
;   LRCLK  side-set pin base + 1
;
; Words are pulled left channel first, MSB first. LRCLK changes one BCLK ahead
; of the first bit of each channel, as I2S requires.
;

.program i2s_out_32
.side_set 2
;                      /--LRCLK
;                      |/-BCLK
;                      ||
pull block      side 0b01

; left channel, LRCLK low
out pins, 1     side 0b00
set x, 29       side 0b01

L1:
out pins, 1     side 0b00
jmp x--, L1     side 0b01

out pins, 1     side 0b10
pull block      side 0b11

; right channel, LRCLK high
out pins, 1     side 0b10
set x, 29       side 0b11

L2:
out pins, 1     side 0b10
jmp x--, L2     side 0b11

out pins, 1     side 0b00
